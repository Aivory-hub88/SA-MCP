# Single-system fallback
SAP_URL=https://my-s4.example.com
SAP_CLIENT=100
SAP_AUTH_TYPE=basic
SAP_USERNAME=
SAP_PASSWORD=
# bearer: SAP_TOKEN=...
# oauth2: SAP_OAUTH_TOKEN_URL + SAP_OAUTH_CLIENT_ID + SAP_OAUTH_CLIENT_SECRET (+SAP_OAUTH_SCOPE)
SAP_ODATA_VERSION=v2
SAP_SERVICE=/sap/opu/odata/sap/API_BUSINESS_PARTNER
SAP_VERIFY_SSL=true

# Multi-system (recommended). Unset SAP_URL* to use file.
# SAP_INSTANCES_JSON=./instances.json
# SAP_INSTANCES={"prod":{"url":"https://s4.example.com","client":"100","username":"u","password":"p","service":"/sap/opu/odata/sap/API_BUSINESS_PARTNER"}}

# Master write gate. Keep 0 for read-only.
SAP_MCP_ENABLE_WRITES=0
# Gated exposition (fr0ster style): readonly | high. Prod: readonly.
SAP_EXPOSITION=readonly,high
# Entity allow/deny globs (deny wins). E.g. SAP_ENTITY_DENY=T_*,/IWFND/*
SAP_ENTITY_ALLOW=
SAP_ENTITY_DENY=
# Per-request SAP credential override: Full tenants only + opt-in.
SAP_MCP_ALLOW_AUTH_OVERRIDE=0
SAP_MCP_AUDIT_LOG=./sa-mcp-audit.jsonl
SAP_METADATA_CACHE_TTL_SECS=600

# Transports
MCP_TRANSPORT=stdio
MCP_LISTEN=127.0.0.1:8788
MCP_ALLOW_REMOTE_HTTP=0
MCP_AUTH_ENABLED=false
MCP_AUTH_TOKEN=
SAP_MCP_TOKEN=

# Rate limiting per (tenant, instance, tool)
SAP_MCP_RATE_LIMIT_MODE=off
